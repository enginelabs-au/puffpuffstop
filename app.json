{
  "expo": {
    "name": "PuffPuffStop",
    "slug": "puffpuffstop",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "puffpuffstop",
    "userInterfaceStyle": "dark",
    "description": "A 16+ wellness habit coach for teens and young adults. Not a kids app. Not a medical device.",
    "ios": {
      "bundleIdentifier": "au.com.enginelabs.puffpuffstop",
      "appleTeamId": "256U2M55W7",
      "supportsTablet": false,
      "buildNumber": "22",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "PuffPuffStop reads heart rate, HRV, oxygen, and breathing around a puff log you approve. This is wellness context, not medical advice.",
        "NSHealthUpdateUsageDescription": "PuffPuffStop does not write workout or vape data to Apple Health.",
        "CFBundleSpokenName": "Puff Puff Stop",
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "Puff Puff Stop",
            "INAlternativeAppNamePronunciationHint": "puff puff stop"
          },
          {
            "INAlternativeAppName": "PuffPuff Stop"
          }
        ]
      }
    },
    "android": {
      "package": "au.com.enginelabs.puffpuffstop",
      "adaptiveIcon": {
        "backgroundColor": "#00000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-quick-log",
      "./plugins/with-health",
      "expo-file-system",
      [
        "expo-notifications",
        {
          "color": "#00B8F8",
          "defaultChannel": "daily-reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00B8F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
